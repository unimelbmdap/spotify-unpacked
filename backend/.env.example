# Backend HTTP
APP_ALLOWED_ORIGINS=http://localhost:5173

# SQLite database file (relative to backend/)
DATABASE_URL=sqlite+aiosqlite:///./donations.db

# Salt for hashing client IPs in audit/metadata. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
IP_HASH_SALT=change-me-to-a-64-char-hex-string

# Admin basic auth (single shared credential)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# Consent
CONSENT_VERSION=v1.0
CONSENT_DIR=./consent

# Local storage for donation bundles. Each donation lands here as
# `donation_<code>__<ts>__<id>.zip` plus a sidecar `.json` with donor
# metadata. In docker-compose this directory is on a host-mounted
# volume so a sync script (rclone/aterm/…) can read the bundles
# without going through the FastAPI process.
DONATIONS_STORAGE_DIR=./data/donations

# Mediaflux integration — NOT used by the /api/donate request path.
# Reserved for the offline sync script that will push stored bundles
# to Mediaflux. Safe to leave at defaults until that script lands.
MEDIAFLUX_CLIENT=stub               # stub | aterm
# Namespace each asset lives in. The MDAP project is a collection asset,
# not a namespace, so this is its parent (e.g. /projects). Grouping
# happens via MEDIAFLUX_COLLECTION_ID below, not via sub-namespaces.
MEDIAFLUX_NAMESPACE=/projects
# Asset id of the "donations" sub-collection in MDAP's project.
# Set this so each donation shows up grouped in Asset Finder.
MEDIAFLUX_COLLECTION_ID=
# Used only when MEDIAFLUX_CLIENT=aterm:
MEDIAFLUX_HOST=mediaflux.researchsoftware.unimelb.edu.au
MEDIAFLUX_PORT=443
MEDIAFLUX_TOKEN=
ATERM_JAR_PATH=/opt/mediaflux/aterm.jar
# Host path of aterm.jar (mounted read-only into the container by
# docker-compose). Default matches the local install one-liner in
# the README.
ATERM_JAR_HOST_PATH=~/.local/mflux/aterm.jar

# Upload limits
MAX_FILES_PER_REQUEST=10
MAX_BYTES_PER_FILE=52428800        # 50 MiB
MAX_BYTES_PER_REQUEST=209715200    # 200 MiB
RATE_LIMIT_DONATE=5/minute
