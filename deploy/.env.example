# Copy to deploy/.env and fill in. docker compose reads this file for both
# variable substitution (Caddy) and backend container env.
#
# NOTE: Docker Compose interpolates this file, so any literal `$` in a value
# must be written as `$$`. This matters for BASIC_AUTH_HASH (and any password
# containing `$`); the helper in README.md handles the escaping for you.

# ---- Public site / TLS (Caddy) ----
# Public hostname Caddy serves. With a real domain and reachable :80/:443,
# Caddy auto-provisions a Let's Encrypt certificate.
SITE_ADDRESS=donate.example.edu.au
# Full origin URL, used for the backend CORS allow-list.
SITE_URL=https://donate.example.edu.au
# Email for Let's Encrypt registration + expiry notices.
ACME_EMAIL=admin@example.edu.au
# Space-separated CIDRs allowed to reach /admin and /api/admin (e.g. UoM ranges).
# Required: if blank, admin access is denied.
ADMIN_ALLOWED_IPS=203.0.113.0/24 198.51.100.0/24

# ---- Optional basic-auth gate (Caddy front door for the public site) ----
# The public site is OPEN by default. These vars are only used if you re-enable
# the gate by adding `import basicgate` back to the Caddyfile. When enabled:
# BASIC_AUTH_HASH must be a `caddy hash-password` bcrypt hash with every `$`
# doubled to `$$`, and both must be set.
# BASIC_AUTH_USER=spotify
# BASIC_AUTH_HASH=CHANGE_ME_ESCAPED_BCRYPT_HASH

# ---- Backend secrets (injected into the backend container) ----
# Generate hex secrets with: python -c "import secrets; print(secrets.token_hex(32))"
IP_HASH_SALT=CHANGE_ME_64_HEX_CHARS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_ME_RANDOM_SECRET
CONSENT_VERSION=v1.0

# ---- Mediaflux sync (mflux-sync container) ----
# Parent collection; bundles land in $MFLUX_DEST_PARENT/donations.
MFLUX_DEST_PARENT=/projects/proj-4180_spotify_unpacked-1128.4.1450
# Secure identity token (participant-acm role) from the token portal:
# https://mediaflux.researchsoftware.unimelb.edu.au/token-portal/
# If the token ever contains a literal `$`, double it to `$$` (see header note).
MFLUX_TOKEN=
# Optional overrides (defaults baked into the image):
# MFLUX_HOST=mediaflux.researchsoftware.unimelb.edu.au
# MFLUX_PORT=443
# MFLUX_TRANSPORT=https
# MFLUX_SCAN_INTERVAL=300

# ---- Database backup (backend) ----
# The backend writes a daily VACUUM INTO snapshot into BACKUP_DIR (set to a path
# inside the donations tree in docker-compose.prod.yml, so mflux-sync ships it).
# Defaults are fine; uncomment to override.
# BACKUP_ENABLED=true
# BACKUP_INTERVAL_HOURS=24
